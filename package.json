{
  "name": "osembo-school",
  "version": "1.0.0",
  "description": "Osembo School management app",
  "author": "Osembo School",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --publish never"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/browser": "^6.0.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/filesystem": "^6.0.1",
    "@capacitor/share": "^6.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "electron": "^31.7.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.osembo.school",
    "productName": "Osembo School",
    "files": ["electron/**","www/**","build/icon.png","package.json"],
    "directories": {"output":"dist"},
    "win": {
      "target": [{"target":"nsis","arch":["x64"]},{"target":"portable","arch":["x64"]}],
      "icon": "build/icon.png"
    },
    "nsis": {"oneClick":false,"allowToChangeInstallationDirectory":true,"createDesktopShortcut":true}
  }
}
